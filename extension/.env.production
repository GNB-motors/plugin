# Production build config — picked up automatically by `npm run build`.
#
# Why this file exists: the release build must NOT inherit the dev-box URL from
# .env. vite.config.js derives host_permissions from VITE_BACKEND_BASE_URL, so a
# build that reads .env ships the dev host in the manifest to the Web Store.
# Vite loads .env.production after .env and it wins, so `npm run build` is safe
# by default while `npm run dev` still uses whatever .env points at.
#
# Committed on purpose: no secrets, and the value must not vary by machine.
# The /v1 prefix is required — the API returns 405 without it.
VITE_BACKEND_BASE_URL=https://api.app.gnbedge.in/v1

# Nothing else is set here on purpose. The only other VITE_ vars the code reads
# are VITE_STATUS_POLL_INTERVAL_MINUTES (default 2), VITE_LOG_RETENTION_COUNT
# (default 500) and VITE_MAX_RETRY_ATTEMPTS (default 2), and the in-code
# defaults are what we want in production. Anything else you may see in .env or
# .env.example — VITE_POLL_INTERVAL_MINUTES, VITE_INTER_TASK_DELAY_MS,
# VITE_VIN_CACHE_TTL_HOURS, VITE_TOKEN_EXPIRY_BUFFER_SECONDS,
# VITE_SEARCH_WINDOW_MINUTES — is dead config that no source file reads.
