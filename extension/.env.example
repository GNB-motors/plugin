# Local development config. Copy to .env — `npm run dev` reads it.
#
# Release builds do NOT use this file. `npm run build` runs in production mode
# and .env.production (committed, points at the prod API) overrides whatever is
# here, so pointing .env at a dev box cannot leak into a Web Store submission.

# Backend base URL for local work.
# NOTE: do NOT include /api/extension — the extension adds its API prefix itself.
# Do include the API version prefix (…/v1); the API returns 405 without it.
# Whatever origin you set is added to host_permissions automatically by
# vite.config.js, because MV3 blocks fetches to hosts absent from the manifest.
VITE_BACKEND_BASE_URL=https://your-backend.example.com/v1

# Minutes between background status polls (default: 2).
# Note the STATUS_ prefix — an older VITE_POLL_INTERVAL_MINUTES appears in some
# .env files but no source file reads it, so setting that name does nothing.
VITE_STATUS_POLL_INTERVAL_MINUTES=2

# Max telemetry events retained in chrome.storage.local (default: 500).
VITE_LOG_RETENTION_COUNT=500

# Retry attempts for failed backend calls (default: 2).
VITE_MAX_RETRY_ATTEMPTS=2
